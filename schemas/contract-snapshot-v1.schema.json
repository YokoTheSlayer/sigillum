{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YokoTheSlayer/sigillum/schemas/contract-snapshot-v1.schema.json",
  "title": "Sigillum contract snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "change_id",
    "openspec_schema",
    "artifacts",
    "fingerprint"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "change_id": {
      "$ref": "#/$defs/identifier"
    },
    "openspec_schema": {
      "$ref": "#/$defs/identifier"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "fingerprint": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9._-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "relative_path",
        "content_sha256"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/identifier"
        },
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\).+$"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
