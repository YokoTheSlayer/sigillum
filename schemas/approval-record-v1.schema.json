{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YokoTheSlayer/sigillum/schemas/approval-record-v1.schema.json",
  "title": "Sigillum approval record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "change_id",
    "contract_fingerprint"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "change_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9._-]+$"
    },
    "contract_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
